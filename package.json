{
  "name": "interviewiq",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "client": "npm run dev --workspace=client",
    "server": "node server/src/server.js",
    "test": "npm run test --workspace=server && npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1"
  }
}
